PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://utilisateur:mot_de_passe@serveur:5432/base_de_donnees

JWT_SECRET=remplacer_par_une_cle_secrete_longue_et_difficile_a_deviner
JWT_EXPIRES_IN=24h

FRONTEND_URL=

# URL publique utilisee dans les liens transactionnels.
PRORECUP_FRONTEND_URL=https://prorecup-frontend.onrender.com

# Email transactionnel (Resend). Ne jamais commiter la vraie cle.
RESEND_API_KEY=
PRORECUP_EMAIL_FROM=Pro Recup <no-reply@prorecup.com>
PRORECUP_SUPPORT_EMAIL=support@prorecup.com

# UUID de l'organisation interne autorisee a traiter les demandes d'onboarding.
PRORECUP_INTERNAL_ORGANISATION_ID=
