{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "mocha --require ./tests/test-environment.js tests/**/*.test.js --exit",
    "db:export": "node scripts/export-database.js",
    "test:mission01": "node --test tests/mission01.regression.mjs",
    "test:mission02": "node --test tests/mission02.server.mjs tests/mission02.browser.mjs tests/mission02.contracts.mjs",
    "test:mission02:server": "node --test tests/mission02.server.mjs",
    "test:mission02:browser": "node --test tests/mission02.browser.mjs",
    "test:mission03": "node --test tests/mission03.services.mjs tests/mission03.portal.mjs tests/mission03.pesee.mjs tests/mission03.legacy.mjs tests/mission03.browser.mjs tests/mission03.baseline.mjs",
    "test:mission04": "node --test tests/mission04.protocol.mjs tests/mission04.legacy.mjs tests/mission04.browser.mjs",
    "test:mission04:postgres": "node tests/mission04.pg-runner.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^6.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.7.1",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "mocha": "^9.2.2",
    "supertest": "^6.3.4"
  },
  "overrides": {
    "brace-expansion": "1.1.21",
    "js-yaml": "4.3.2"
  }
}
